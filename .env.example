# mock = gesimuleerde data, ibahd = echte ibaHD-server (vereist ibaHD-Server-API-Read licentie)
ALMA_SOURCE=mock

# Alleen voor ALMA_SOURCE=ibahd: quick-connect JSON uit ibaHD Manager
# (bevat Host, Port, ApiKey, TlsServerCertificate). Niet committen!
ALMA_IBAHD_QUICK_CONNECT=secrets/quick_connect.json

# Mapping logische signaalnaam -> ibaHD channel_id (JSON-bestand)
ALMA_SIGNAL_MAP=signals.json
