# Kopieer naar .env en vul in. .env staat in .gitignore: commit nooit geheimen.
# Zet geen opmerkingen achter een waarde; docker compose en de app lezen dit bestand allebei.

# --- Databron ---
# mock = gesimuleerde data (het dashboard toont dan een DEMO-banner)
# udp = live telegrammen van iba (ibaPDA, Generic UDP output module), zie het blok hieronder
# ibahd = echte ibaHD-server (vereist de ibaHD-Server-API-Read licentie; levert niet in realtime)
ALMA_SOURCE=mock

# --- Inloggen via Authentik (OpenID Connect) ---
# De externe URL waarop gebruikers het dashboard openen: https, zonder pad.
# Registreer in Authentik als redirect URI: <ALMA_PUBLIC_URL>/auth/callback
ALMA_PUBLIC_URL=https://alma.example.com
# Issuer van de Authentik-provider: https://<authentik-host>/application/o/<application-slug>/
ALMA_OIDC_ISSUER=https://auth.example.com/application/o/alma/
ALMA_OIDC_CLIENT_ID=
ALMA_OIDC_CLIENT_SECRET=
# Minstens 32 tekens. Genereer er een met:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ALMA_SESSION_SECRET=
# Optioneel: alleen leden van deze Authentik-groepen toelaten (komma-gescheiden).
# Leeg = iedereen die Authentik voor deze applicatie toelaat.
# ALMA_ALLOWED_GROUPS=alma-dashboard

# Alleen voor lokale ontwikkeling zonder login. NOOIT in productie.
# ALMA_AUTH_ENABLED=false

# --- Systeemmodus (PLC-modenummer -> naam) en welke modi als compensatie aan tellen ---
# De standaardnummers zijn placeholders: zet hier de echte codes van de BM010-PLC.
# ALMA_SYSTEM_MODES='{"0": "System off", "1": "HPU on", "2": "Position control", "3": "CT low", "4": "Damping"}'
# ALMA_COMPENSATING_MODES=3,4

# --- Cilindergeometrie voor de kabelspanning (placeholders, vervang door echte BM010-waarden) ---
# ALMA_CYLINDER__BORE_DIAMETER_M=0.200
# ALMA_CYLINDER__ROD_DIAMETER_M=0.140
# ALMA_CYLINDER__REEVING_FALLS=4
# ALMA_CYLINDER__EFFICIENCY=0.95

# --- Dashboard: schaal van de joystick-cirkels in mm (buitenste ring), placeholders ---
# ALMA_TOWER_FULLSCALE_MM=60
# ALMA_VESSEL_FULLSCALE_MM=500
# Na hoeveel seconden zonder nieuwe meting de balk NO DATA toont
# ALMA_STALE_AFTER_S=30

# --- Live UDP-ingest (alleen bij ALMA_SOURCE=udp) ---
# Poort waarop iba zijn telegrammen naartoe stuurt. docker compose publiceert dezelfde poort (UDP).
# ALMA_UDP_PORT=5005
# Alleen docker compose: op welk IP-adres van de host de UDP-poort wordt gepubliceerd. Standaard alleen
# localhost. De ibaPDA zit in een VPN met de server: zet hier het IP van de server in die tunnel.
# ALMA_UDP_PUBLISH=10.8.0.1
# Alleen deze bronadressen worden geaccepteerd: IP's of netwerken, komma-gescheiden. VERPLICHT bij udp.
# Zet hier het adres van de ibaPDA-machine zoals de server het ziet (controleer met alma.udp_check).
# UDP is niet geauthenticeerd: het filter is alleen veilig omdat het VPN het verkeer afschermt.
# ALMA_UDP_ALLOWED_SOURCES=10.8.0.2
# Alleen voor lokale ontwikkeling: elk bronadres toelaten (kan niet samen met ALLOWED_SOURCES).
# ALMA_UDP_ALLOW_ANY_SOURCE=true
# Hoeveel minuten metingen de server in het geheugen houdt (1-60); de periodekeuze in het dashboard volgt dit.
# ALMA_CACHE_MINUTES=10
# Indeling van het telegram (offsets, datatypes, byte-volgorde); moet overeenkomen met de ibaPDA-module.
# ALMA_UDP_FORMAT=/app/udp_format.json

# --- ibaHD (alleen bij ALMA_SOURCE=ibahd; de standaardpaden werken in Docker) ---
# Test de verbinding eerst met: python -m alma.ibahd_check (zie README)
# ALMA_IBAHD_QUICK_CONNECT=/app/secrets/quick_connect.json
# ALMA_SIGNAL_MAP=/app/signals.json
