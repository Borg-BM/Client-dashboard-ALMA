# Copy to .env and fill in. .env is in .gitignore: never commit secrets.
# Do not put comments after a value; docker compose and the app both read this file.

# --- Data source ---
# mock = simulated data (the dashboard then shows a DEMO banner)
# udp = live telegrams from iba (ibaPDA, Generic UDP output module), see the block below
# ibahd = real ibaHD server (requires the ibaHD-Server-API-Read licence; does not deliver in real time)
ALMA_SOURCE=mock

# --- Login via Authentik (OpenID Connect) ---
# The external URL users open the dashboard with: https, without a path.
# Register in Authentik as redirect URI: <ALMA_PUBLIC_URL>/auth/callback
ALMA_PUBLIC_URL=https://alma.example.com
# Issuer of the Authentik provider: https://<authentik-host>/application/o/<application-slug>/
ALMA_OIDC_ISSUER=https://auth.example.com/application/o/alma/
ALMA_OIDC_CLIENT_ID=
ALMA_OIDC_CLIENT_SECRET=
# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ALMA_SESSION_SECRET=
# Optional: only admit members of these Authentik groups (comma-separated).
# Empty = everyone Authentik admits for this application.
# ALMA_ALLOWED_GROUPS=alma-dashboard

# Local development without login only. NEVER in production.
# ALMA_AUTH_ENABLED=false

# --- System mode (PLC mode number -> name) and which modes count as compensation on ---
# The default numbers are placeholders: put the real codes of the BM010 PLC here.
# ALMA_SYSTEM_MODES='{"0": "System off", "1": "HPU on", "2": "Position control", "3": "CT low", "4": "Damping"}'
# ALMA_COMPENSATING_MODES=3,4

# --- Cylinder geometry for the cable tension (placeholders, replace with real BM010 values) ---
# ALMA_CYLINDER__BORE_DIAMETER_M=0.200
# ALMA_CYLINDER__ROD_DIAMETER_M=0.140
# ALMA_CYLINDER__REEVING_FALLS=4
# ALMA_CYLINDER__EFFICIENCY=0.95

# --- Dashboard: scale of the joystick circles in mm (outer ring), placeholders ---
# ALMA_TOWER_FULLSCALE_MM=60
# ALMA_VESSEL_FULLSCALE_MM=500
# After how many seconds without a new measurement the bar shows NO DATA
# ALMA_STALE_AFTER_S=30

# --- Live UDP ingest (only with ALMA_SOURCE=udp) ---
# Port iba sends its telegrams to. docker compose publishes the same port (UDP).
# ALMA_UDP_PORT=5005
# docker compose only: on which IP address of the host the UDP port is published. Default is localhost
# only. The ibaPDA is in a VPN with the server: put the server's IP in that tunnel here.
# ALMA_UDP_PUBLISH=10.8.0.1
# Only these source addresses are accepted: IPs or networks, comma-separated. REQUIRED with udp.
# Put the address of the ibaPDA machine as the server sees it (check with alma.udp_check).
# UDP is not authenticated: the filter is only safe because the VPN shields the traffic.
# ALMA_UDP_ALLOWED_SOURCES=10.8.0.2
# Local development only: allow any source address (cannot be combined with ALLOWED_SOURCES).
# ALMA_UDP_ALLOW_ANY_SOURCE=true
# How many minutes of measurements the server keeps in memory (1-60); the period selector in the dashboard follows this.
# ALMA_CACHE_MINUTES=10
# Layout of the telegram (offsets, data types, byte order); must match the ibaPDA module.
# ALMA_UDP_FORMAT=/app/udp_format.json

# --- ibaHD (only with ALMA_SOURCE=ibahd; the default paths work in Docker) ---
# Test the connection first with: python -m alma.ibahd_check (see README)
# ALMA_IBAHD_QUICK_CONNECT=/app/secrets/quick_connect.json
# ALMA_SIGNAL_MAP=/app/signals.json
